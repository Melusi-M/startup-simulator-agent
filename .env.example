# demo: deterministic and free
# crewai: real Claude-powered agents
STARTUP_SIMULATOR_MODE=demo

ANTHROPIC_API_KEY=replace-with-your-api-key

# The CrewAI Anthropic integration requires the provider prefix.
STARTUP_SIMULATOR_MODEL=anthropic/replace-with-a-supported-claude-model

# Keep startup ideas and agent outputs private.
CREWAI_DISABLE_TELEMETRY=true
CREWAI_TRACING_ENABLED=false
STARTUP_SIMULATOR_MAX_TOKENS=4000